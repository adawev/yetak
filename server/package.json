{
  "name": "yetak-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "korpus": "node scripts/korpus.mjs",
    "predev": "node scripts/korpus.mjs",
    "prebuild": "node scripts/korpus.mjs",
    "pretypecheck": "node scripts/korpus.mjs",
    "pretest": "node scripts/korpus.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
